<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="search_product_lot_filter_inherit_babylon" model="ir.ui.view">
            <field name="name">stock.production.lot.search.inherit</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.search_product_lot_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='on_hand']" position="before">
                    <filter string="Archived" name="inactive" />
                </xpath>
            </field>
        </record>
        <record id="view_babylon_customization_lot" model="ir.ui.view">
            <field name="name">stock.production.lot.inherit.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="required">0</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_component_lot_form" model="ir.ui.view">
            <field name="name">stock.production.lot.form</field>
            <field name="model">stock.lot</field>
            <field name="priority">11</field>
            <field name="arch" type="xml">
                <form string="Lots/Serial Numbers">
                    <sheet>
                        <field name="company_id" invisible="1"/>
                        <field name="display_complete" invisible="1"/>

                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_button_box" name="button_box"
                             invisible="not display_complete">
                            <button class="oe_stat_button" name="action_lot_open_transfers"
                                    type="object" icon="fa-truck" help="Transfers"
                                    invisible="delivery_count == 0">
                                <field name="delivery_count" widget="statinfo" string="Transfers"/>
                            </button>
                            <button name="action_lot_open_quants" icon="fa-arrows" class="oe_stat_button" type="object">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Location</span>
                                </div>
                            </button>
                            <button name="%(stock.action_stock_report)d" icon="oi-arrow-up" class="oe_stat_button" type="action">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Traceability</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="e.g. LOT/0001/20121"/>
                            </h1>
                        </div>
                        <group name="main_group">
                            <group>
                                <field name="product_id" string="Component" context="{'default_is_ingredient':'True', 'default_tracking': 'lot'}" readonly="context.get('set_product_readonly', False)" force_save="1" help="Ingredient this lot/serial number contains. You cannot change it anymore if it has already been moved."/>
                                <label for="product_qty"  invisible="not display_complete"/>
                                <div class="o_row" invisible="not display_complete">
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                </div>
                                <field name="default_code" string="Component Code"/>
<!--                                <field name="incl" string="INCI"/>-->
                                 <field name="purchase_qty"  string="Purchase Qty" />
                                <field name="total_value"  string="Total Value" />
                                <field name="avg_cost"  string="Average Cost" />
                                <field name="standard_price"  string="Cost" />
                                <field name="last_delivery_partner_id" />
                                <field name="expiration_date" />
                                <field name="vmc_code" string="VMC code"/>
                                <field name="vendor_id" string="Vendor" />
                                <field name="manufacture_id" string="Manufacturer" />
                                <field name="customer_id" string="Customer"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="location_id" invisible="not location_id" groups="stock.group_stock_manager"/>
                                <field name="last_delivery_partner_id" invisible="not last_delivery_partner_id" groups="stock.group_stock_manager"/>
                            </group>
                            <group></group>
                            <field name="lot_properties" nolabel="1" columns="2" hideAddButton="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_component_lot_tree" model="ir.ui.view">
            <field name="name">stock.production.lot.tree</field>
            <field name="model">stock.lot</field>
            <field name="priority">11</field>
            <field name="arch" type="xml">
                <list string="Lots/Serial Numbers" multi_edit="1">
                    <field name="name" decoration-bf="1"/>
                    <field name="default_code" string="Component Code" optional="show"/>
                    <field name="product_id" string="Components" readonly="1"/>
                    <field name="create_date" optional="show"/>
                    <field name="location_id" string="Location" optional="show"/>
                    <field name="product_qty" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="last_delivery_partner_id" optional="hide" string="Transfer to"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="lot_properties" optional="hide"/>
<!--                    <field name="product_qty" optional="hide"/>-->
                    <field name="total_value"  string="Total Value" optional="show"/>
                    <field name="avg_cost"  string="Average Cost" optional="show" />
                    <field name="standard_price"  string="Cost" optional="show" />
                </list>
            </field>
        </record>

        <record id="view_product_component_form" model="ir.ui.view">
            <field name="name">product.product.form</field>
            <field name="model">product.product</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Product Components">
                    <header>
                        <button string="Print Labels" type="object" name="action_open_label_layout" invisible="type not in ['consu', 'product', 'combo']"/>
                    </header>
                    <sheet name="product_form">
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    name="action_update_quantity_on_hand"
                                    icon="fa-cubes"
                                    type="object"
                                    invisible="not show_on_hand_qty_status_button">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value d-flex gap-1">
                                        <field name="qty_available" nolabel="1" class="oe_inline"/>
                                        <field name="uom_name" class="oe_inline"/>
                                    </span>
                                    <span class="o_stat_text">On Hand</span>
                                </div>
                            </button>
                        </div>
                        <field name="type" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <field name="id" invisible="1"/>
                        <field name="show_on_hand_qty_status_button" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" string="Component Name"/>
                            <h1><field name="name"  placeholder="e.g. Component - Tube - Coconut Buttercream Hand Cream 2oz"/></h1>
                        </div>
                        <group>
                            <group name="component_code" >
                                <field name="type" required="1" string="Component Type" />
                                <field name="default_code" required="1" string="Component Code" />
                            </group>
                            <group>
                                <field name="barcode"  string="Barcode" />
                                <field name="tracking" string="Tracking" />
                            </group>
                            <group name="uom_id">
                                <field name="uom_id" domain="[('id', '=',1)]"   string="Unit"/>
                                <field name="uom_po_id" invisible="1" />
                            </group>
                            <group name="traceability" position="inside">
                                <field name="use_expiration_date" string="Expiration Date" invisible="tracking == 'none'"/>
                            </group>

                            <group string="Dates" name="expiry_and_lots" groups="stock.group_production_lot"
                                   invisible="tracking == 'none' or not use_expiration_date">
                                <label for="expiration_time"/>
                                <div>
                                    <field name="expiration_time" class="oe_inline"/>
                                    <span> days after receipt</span>
                                </div>
                                <label for="use_time"/>
                                <div>
                                    <field name="use_time" class="oe_inline"/>
                                    <span> days before expiration date</span>
                                </div>
                                <label for="removal_time"/>
                                <div>
                                    <field name="removal_time" class="oe_inline"/>
                                    <span> days before expiration date</span>
                                </div>
                                <label for="alert_time"/>
                                <div>
                                    <field name="alert_time" class="oe_inline"/>
                                    <span> days before expiration date</span>
                                </div>
                            </group>
                        </group>


                    </sheet>



                </form>
            </field>
        </record>



        <record id="view_product_component_tree" model="ir.ui.view">
            <field name="name">product.ingredients.tree</field>
            <field name="model">product.product</field>
            <field eval="8" name="priority"/>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button string="Print Labels" type="object" name="action_open_label_layout"/>
                    </header>
                    <field name="default_code" string="Component Code"/>
                    <field name="name" string="Component Name"/>
<!--                    <field name="incl" string="INCI" />-->
                    <field name="barcode"  string="Barcode" />
                    <field name="qty_available" string="Qty"/>
                    <field name="uom_id" string="Unit"/>
                </list>
            </field>
        </record>

        <record id="action_product_components" model="ir.actions.act_window">
            <field name="name">Product Components</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_component','=',True)]</field>
            <field name="context">{'default_is_component':True}</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_component_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_component_form')})]"/>


            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Product Components
                </p>
            </field>
        </record>

        <record id="action_product_component_lots" model="ir.actions.act_window">
            <field name="name">Product Component Lots</field>
            <field name="type">ir.actions.act_window</field>

            <field name="res_model">stock.lot</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_component_lot_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('babylon_customization.view_component_lot_form')})]"/>
            <field name="domain">[('is_component','=',True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Product Components Lots
                </p>
            </field>
        </record>

        <menuitem
                id="menu_product_components"
                name="Components"
                action="action_product_components"
                parent="stock.menu_stock_inventory_control"
                sequence="3"/>

        <menuitem
                id="menu_product_component_lots"
                name="Components Lots"
                action="action_product_component_lots"
                parent="stock.menu_stock_inventory_control"
                sequence="4"/>

    </data>
</odoo>

