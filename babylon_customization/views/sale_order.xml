<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_sale_link" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sale.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="sale_order_ids" widget="many2many_tags"/>
            </xpath>

        </field>
    </record>

    <odoo>
        <!-- Extend Sale Order Form -->
        <record id="view_order_form_inherit_po_ref" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.po.ref</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Add field in sale order line tree -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                    <field name="purchase_order_ids" widget="many2many_tags" readonly="1"/>
                </xpath>
            </field>
        </record>
    </odoo>


    <record id="action_purchase_order_from_list" model="ir.actions.server">
        <field name="name">Create a Purchase Order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.create_purchase_order()
        </field>
    </record>



</odoo>

